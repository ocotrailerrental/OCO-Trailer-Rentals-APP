{
  "name": "oco-trailer-rentals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/finalize-static-build.mjs",
    "build:nocheck": "vite build && node scripts/finalize-static-build.mjs",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\" --quiet",
    "lint:js": "eslint . --report-unused-disable-directives",
    "lint:types": "tsc --noEmit",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css",
    "verify": "npm run lint && npm test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.11",
    "@tanstack/react-start": "1.168.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.1.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
