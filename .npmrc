# @tailwindcss/vite 4.1.x declares a peer range of vite ^5.2 || ^6 || ^7, while this
# project runs vite 8. The combination works — it is what the app was built and run
# on — but npm's strict peer resolution refuses to install it. Bun ignored this;
# npm and Vercel do not.
#
# Revisit when @tailwindcss/vite publishes a release that lists vite 8 as a
# supported peer, then delete this file.
legacy-peer-deps=true
