<?xml version="1.0" encoding="UTF-8"?>
<!--
  Public, indexable routes only. Account and booking-flow pages are excluded here
  and disallowed in robots.txt. Rewrite <loc> to absolute URLs once a domain is
  pointed at the app.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>/book</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
