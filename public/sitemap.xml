<?xml version="1.0" encoding="UTF-8"?>
<!--
  Public, indexable routes only. Account and booking-flow pages are excluded here
  and disallowed in robots.txt.

  <loc> must be an absolute URL — the sitemap protocol rejects relative paths, so
  the earlier version of this file was thrown away by crawlers rather than read.
  If the app moves to its own domain, change these and the Sitemap: line in
  robots.txt together.

  /book is deliberately absent: without search parameters it renders a "complete
  your rental search" prompt, which is not a page worth having in an index. The
  two trailer pages are the ones that answer a search for "car hauler rental
  Omaha", so they are listed here explicitly.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://oco-trailer-rentals-app.vercel.app/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://oco-trailer-rentals-app.vercel.app/trailers/20-foot-car-hauler</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://oco-trailer-rentals-app.vercel.app/trailers/24-foot-car-hauler</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://oco-trailer-rentals-app.vercel.app/terms</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://oco-trailer-rentals-app.vercel.app/privacy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
